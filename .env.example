# Reuse pgclear's local test database; Jobs owns only the pgclear_jobs schema.
# Any dedicated test database ending in _test can be configured instead.
PGCLEAR_JOBS_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pgclear_test

# Standalone pgclear-jobs migrate reads DATABASE_URL from the environment or .env.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_app
