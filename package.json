{
  "name": "@kequtech/pgclear-jobs",
  "version": "0.1.0",
  "description": "Durable PostgreSQL jobs with typed definitions and explicit database scopes",
  "type": "module",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kequtech/pgclear-jobs.git"
  },
  "homepage": "https://github.com/kequtech/pgclear-jobs#readme",
  "bugs": {
    "url": "https://github.com/kequtech/pgclear-jobs/issues"
  },
  "bin": {
    "pgclear-jobs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "docs/*.md",
    "todo.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "jobs:migrate": "npm run build && node dist/cli.js migrate",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:compile": "node scripts/build.mjs --test",
    "test:unit": "npm run build && npm run test:compile && node --test .test-dist/test/*.test.js",
    "test:integration": "npm run test:compile && node --env-file-if-exists=.env --test --test-concurrency=1 .test-dist/test/integration/*.test.js",
    "test:load": "npm run test:compile && node --env-file-if-exists=.env .test-dist/test/load/queue-load.js",
    "test": "npm run test:unit && npm run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "cron-parser": "^5.10.3"
  },
  "peerDependencies": {
    "@kequtech/pgclear": "^0.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "@kequtech/pgclear": "^0.3.3"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "kequtech": {
    "source": "pgclear-jobs"
  }
}
