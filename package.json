{
  "name": "@kequtech/tenon-jobs",
  "version": "0.1.0",
  "description": "Durable PostgreSQL jobs with typed definitions and explicit database scopes",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kequtech/tenon-jobs.git"
  },
  "homepage": "https://github.com/kequtech/tenon-jobs#readme",
  "bugs": {
    "url": "https://github.com/kequtech/tenon-jobs/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tenon": {
      "types": "./dist/tenon.d.ts",
      "import": "./dist/tenon.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "docs/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:compile": "node scripts/build.mjs --test",
    "test:unit": "npm run build && npm run test:compile && node --test .test-dist/test/*.test.js",
    "test:integration": "npm run test:compile && node --env-file-if-exists=.env --test --test-concurrency=1 .test-dist/test/integration/*.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@kequtech/pgclear": "^0.3.3",
    "cron-parser": "^5.10.3"
  },
  "peerDependencies": {
    "@kequtech/tenon-orm": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@kequtech/tenon-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kequtech/tenon-orm": "^0.4.5",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "kequtech": {
    "source": "tenon-jobs"
  }
}
